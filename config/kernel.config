
# GLITCH//CORE - Kernel graphics support

# DRM graphics
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y

# VirtIO (QEMU)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y

# Input devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# Keyboard support
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_EVDEV=y

# USB keyboards
CONFIG_USB=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# USB controllers
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# PS/2 keyboards
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y

# Additional keyboard support
CONFIG_INPUT_MATRIXKMAP=y
CONFIG_INPUT_SPARSEKMAP=y

# HID keyboard variants
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_HID_MULTITOUCH=y

# USB keyboard support
CONFIG_USB_HIDDEV=y

# Additional USB support
CONFIG_USB_STORAGE=y

# Input event devices
CONFIG_INPUT_EVDEV=y

# systemd requirements
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PIDS=y

# Namespaces
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# System features
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_UNIX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Graphics and input
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_INPUT_EVDEV=y

# Linux virtual terminal
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
